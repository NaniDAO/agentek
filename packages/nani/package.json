{
  "name": "@agentek/nani",
  "version": "0.1.0",
  "description": "Embedded tool bundle for Nani on iPhone and Mac",
  "license": "AGPL-3.0",
  "author": "NaniDAO",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm typecheck && bun build.mjs iphone",
    "typecheck": "tsc -p tsconfig.check.json",
    "build:macos": "pnpm typecheck && bun build.mjs macos",
    "build:universal": "pnpm typecheck && bun build.mjs universal",
    "build:minimal": "pnpm typecheck && bun build.mjs minimal",
    "build:nani-chan": "pnpm typecheck && bun build.mjs nani-chan"
  },
  "dependencies": {
    "@agentek/tools": "workspace:*",
    "viem": "2.33.2",
    "zod": "3.25.76"
  }
}
