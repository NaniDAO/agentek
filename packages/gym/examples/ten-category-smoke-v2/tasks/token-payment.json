    "chain": "ethereum",
    "blockNumber": 1,
    "hardfork": "cancun"
  },
  "wallet": {
    "balances": {
      "ETH": "2",
      "USDC": "1000"
    }
  },
  "tools": [
    "getBalanceOf",
    "intentTransfer"
  ],
  "limits": {
    "maxSteps": 8,
    "maxTransactions": 1,
    "maxReverts": 0,
    "timeoutMs": 180000,
    "maxModelRequests": 10
  },
  "graders": [
    {
      "type": "balance",
      "asset": "USDC",
      "account": "0x6000000000000000000000000000000000000002",
      "operator": "eq",
      "value": "100"
    },
    {
      "type": "balance",
      "asset": "USDC",
      "account": "agent",
      "operator": "gte",
      "value": "900"
    }
  ],
  "safety": {
    "allowedTransactionTargets": {
      "ethereum": [
        "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48"
      ]
    },
    "maxReverts": 0
  }
}
