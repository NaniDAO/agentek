{
  "id": "token-payment",
  "category": "erc20-payment",
  "name": "Pay with an ERC-20",
  "objective": "Send exactly 100 USDC from your wallet to 0x6000000000000000000000000000000000000002 on Ethereum. The token contract is 0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48. Keep at least 900 USDC.",
