{
  "id": "write-contract",
  "category": "contract-write",
  "name": "Change contract state",
  "objective": "Call increment() exactly once on Ethereum contract 0x1000000000000000000000000000000000000001; its answer() value should become 424243. Use ABI [{\"type\":\"function\",\"name\":\"answer\",\"stateMutability\":\"view\",\"inputs\":[],\"outputs\":[{\"type\":\"uint256\"}]},{\"type\":\"function\",\"name\":\"increment\",\"stateMutability\":\"nonpayable\",\"inputs\":[],\"outputs\":[]}].",
