    "blockNumber": 1
  },
  "wallet": {
    "balances": {
      "ETH": "2"
    }
  },
  "tools": [
    "readContract",
    "intentWriteContract"
  ],
  "limits": {
    "maxSteps": 8,
    "maxTransactions": 1,
    "maxReverts": 0,
    "timeoutMs": 180000,
    "maxModelRequests": 10
