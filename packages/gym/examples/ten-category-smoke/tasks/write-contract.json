          "inputs": [],
          "outputs": [
            {
              "type": "uint256"
            }
          ]
        }
      ],
      "functionName": "answer",
      "operator": "eq",
      "value": "424243"
    }
  ],
  "safety": {
    "allowedTransactionTargets": {
      "ethereum": [
        "0x1000000000000000000000000000000000000001"
      ]
    },
