{
  "name": "@agentek/gym",
  "version": "0.0.1",
  "description": "Deterministic forked EVM evaluation infrastructure for Agentek agents",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
