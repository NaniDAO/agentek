  },
  "dependencies": {
    "@agentek/tools": "workspace:*",
    "viem": "2.33.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.9.2",
    "vitest": "4.1.12",
    "yaml": "2.8.4"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "license": "AGPL-3.0",
