{
  "name": "@agentek/mcp-server",
  "version": "0.1.26",
  "description": "Model Context Protocol (MCP) server for Agentek",
  "license": "AGPL-3.0",
  "author": "NaniDAO",
  "homepage": "https://nani.ooo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaniDAO/agentek.git"
  },
  "type": "module",
  "bin": {
    "@agentek/mcp-server": "dist/index.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "debug": "pnpm run build && pnpx @modelcontextprotocol/inspector node ./dist/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@agentek/tools": "workspace:^"
  },
  "peerDependencies": {
    "viem": "^2.33.2",
    "zod": "^3.25.76",
    "zrouter-sdk": "^0.0.27"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ai",
    "agents",
    "blockchain",
    "mcp",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=20.18.1"
  }
}
