{
  "name": "@agentek/ai-sdk",
  "version": "0.1.26",
  "description": "AI SDK integration for Agentek tools",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tool": {
      "import": {
        "types": "./dist/tool.d.ts",
        "default": "./dist/tool.mjs"
      },
      "require": {
        "types": "./dist/tool.d.cts",
        "default": "./dist/tool.cjs"
      }
    },
    "./toolkit": {
      "import": {
        "types": "./dist/toolkit.d.ts",
        "default": "./dist/toolkit.mjs"
      },
      "require": {
        "types": "./dist/toolkit.d.cts",
        "default": "./dist/toolkit.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "build:watch": "node ../../scripts/watch-package.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "blockchain",
    "ethereum",
    "tools"
  ],
  "author": "NaniDAO",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaniDAO/agentek.git"
  },
  "homepage": "https://nani.ooo",
  "peerDependencies": {
    "@agentek/tools": "workspace:^",
    "viem": "2.33.2",
    "zod": "3.25.76",
    "ai": "6.0.322"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.9.2",
    "ai": "6.0.322"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
