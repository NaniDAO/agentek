{
  "name": "agentek",
  "description": "A collection of AI agent tools for blockchain interaction",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "workspaces": [
    "packages/ai-sdk",
    "packages/shared",
    "packages/mcp",
    "packages/cli",
    "packages/nani",
    "packages/gym",
    "examples"
  ],
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev": "pnpm -r dev",
    "clean": "rm -rf dist packages/*/dist",
    "test": "vitest -c ./test/vitest.config.ts",
    "test:offline": "vitest run -c ./test/vitest.offline.config.ts",
    "test:live": "vitest run -c ./test/vitest.live.config.ts",
    "test:release": "node --test --test-concurrency=1 scripts/release.test.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "release:check": "pnpm check:pins && pnpm build && pnpm typecheck:examples && pnpm test:offline && pnpm test:release && pnpm check:packages",
    "list": "bun run scripts/tool-count.ts",
    "release": "bash scripts/release.sh",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "check:pins": "node scripts/check-dependency-pins.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "blockchain",
    "ethereum",
    "tools"
  ],
  "author": "NaniDAO",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaniDAO/agentek.git"
  },
  "homepage": "https://nani.ooo",
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.9.2",
    "viem": "2.33.2",
    "vitest": "4.1.12",
    "zod": "4.6.6"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "pnpm": {
    "overrides": {
      "glob": "14.0.2",
      "brace-expansion": "5.0.12",
      "@isaacs/brace-expansion": "5.0.1",
      "qs": "6.16.1",
      "vite": "6.4.5",
      "body-parser": "2.4.0",
      "undici": "7.30.1",
      "viem": "2.33.2",
      "minimatch": "11.0.1",
      "rollup": "4.59.0",
      "ajv": "8.18.0",
      "hono": "4.13.11",
      "@hono/node-server": "2.1.3",
      "express-rate-limit": "8.2.2",
      "path-to-regexp": "8.4.0",
      "fast-uri": "3.1.9",
      "ip-address": "10.7.4",
      "ws": "8.21.0",
      "uuid": "11.1.1",
      "picomatch": "4.0.7",
      "postcss": "8.5.32",
      "nanoid": "3.3.20",
      "source-map-js": "1.2.2",
      "proxy-addr": "2.0.8",
      "@solana/web3.js>jayson": "5.0.0",
      "abitype": "1.2.3",
      "@x402/evm>viem": "2.48.11"
    }
  }
}
